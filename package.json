{
  "name": "gitemon",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "build": "pnpm -r --filter ./apps/web build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "deploy": "pnpm build && pnpm --filter @gitemon/api deploy"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gitemon/creature-gen": "workspace:*",
    "@gitemon/ingest": "workspace:*",
    "@gitemon/scorer": "workspace:*",
    "@gitemon/shared": "workspace:*",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
